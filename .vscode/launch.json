{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Remote Pi Start No Sync",
			"type": "node-terminal",
			"request": "launch",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@192.168.41.181 \"cd /home/atom/cockscreen && ./out/build/pi-zero2w-debug/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Remote Pi Debug",
			"type": "cppdbg",
			"request": "launch",
			"program": "/home/atom/cockscreen/out/build/cross-pi-zero2w-debug/cockscreen",
			"args": [
				"--enable-web-server",
				"http://0.0.0.0:8080"
			],
			"cwd": "/home/atom/cockscreen",
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",
			"preLaunchTask": "Remote Pi: Upload Cross Debug",
			"pipeTransport": {
				"pipeProgram": "ssh",
				"pipeArgs": [
					"-T",
					"atom@192.168.41.181"
				],
				"debuggerPath": "/usr/bin/gdb",
				"quoteArgs": false
			},
			"sourceFileMap": {
				"/home/atom/cockscreen": "${workspaceFolder}"
			},
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		}
	]
}

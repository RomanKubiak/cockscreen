{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Local: Build Debug",
			"type": "shell",
			"command": "cmake --preset local-x86_64-debug && cmake --build --preset local-x86_64-debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Local: Run Debug",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/run-local-debug.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Local: Build Debug",
			"isBackground": true,
			"group": "test"
		},
		{
			"label": "Local: Test & Analyze",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/run-test.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Local: Build Debug",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true,
				"focus": true
			}
		},
		{
			"label": "Local: Cross Build Debug",
			"type": "shell",
			"command": "cmake --preset cross-pi-zero2w-debug && cmake --build --preset cross-pi-zero2w-debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Local: Cross Build Release",
			"type": "shell",
			"command": "cmake --preset cross-pi-zero2w-release && cmake --build --preset cross-pi-zero2w-release",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Remote Pi: Sync Workspace",
			"type": "shell",
			"command": "ssh atom@cockscreen \"mkdir -p /home/atom/cockscreen\" && rsync -az --delete --exclude .git --exclude out --exclude build --exclude .cache --exclude .vscode/ipch ${workspaceFolder}/ atom@cockscreen:/home/atom/cockscreen/",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Remote Pi: Build Debug",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && cmake --preset pi-zero2w-debug && cmake --build --preset pi-zero2w-debug --parallel 2\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Sync Workspace",
			"group": "build"
		},
		{
			"label": "Remote Pi: Upload Cross Debug",
			"type": "shell",
			"command": "ssh atom@cockscreen \"mkdir -p /home/atom/cockscreen/out/build/cross-pi-zero2w-debug\" && rsync -az ${workspaceFolder}/out/build/cross-pi-zero2w-debug/ atom@cockscreen:/home/atom/cockscreen/out/build/cross-pi-zero2w-debug/",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": [
				"Remote Pi: Sync Workspace",
				"Local: Cross Build Debug"
			],
			"group": "build"
		},
		{
			"label": "Remote Pi: Upload Cross Release",
			"type": "shell",
			"command": "ssh atom@cockscreen \"mkdir -p /home/atom/cockscreen/out/build/cross-pi-zero2w-release\" && rsync -az ${workspaceFolder}/out/build/cross-pi-zero2w-release/ atom@cockscreen:/home/atom/cockscreen/out/build/cross-pi-zero2w-release/",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": [
				"Remote Pi: Sync Workspace",
				"Local: Cross Build Release"
			],
			"group": "build"
		},
		{
			"label": "Remote Pi: Run Cross Debug",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && ./out/build/cross-pi-zero2w-debug/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Upload Cross Debug",
			"group": "test",
			"isBackground": true
		},
		{
			"label": "Remote Pi: Smoke Cross Debug",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/run-pi-qt-shader-smoke.sh ./out/build/cross-pi-zero2w-debug/cockscreen scenes/pizero-linux.scene.jsonc 4 18",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Upload Cross Debug",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true,
				"focus": true
			}
		},
		{
			"label": "Remote Pi: Run Cross Release",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && ./out/build/cross-pi-zero2w-release/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Upload Cross Release",
			"group": "test",
			"isBackground": true
		},
		{
			"label": "Remote Pi: Smoke Cross Release",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/run-pi-qt-shader-smoke.sh ./out/build/cross-pi-zero2w-release/cockscreen scenes/pizero-linux.scene.jsonc 4 18",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Upload Cross Release",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true,
				"focus": true
			}
		},
		{
			"label": "Remote Pi: Run Debug",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && ./out/build/pi-zero2w-debug/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Build Debug",
			"group": "test",
			"isBackground": true
		},
		{
			"label": "Remote Pi Start No Sync",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && ./out/build/cross-pi-zero2w-debug/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test"
		},
		{
			"label": "Remote Pi: Smoke Debug",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/run-pi-qt-shader-smoke.sh ./out/build/pi-zero2w-debug/cockscreen scenes/pizero-linux.scene.jsonc 4 18",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Build Debug",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true,
				"focus": true
			}
		},
		{
			"label": "Remote Pi: Build Release",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && cmake --preset pi-zero2w-release && cmake --build --preset pi-zero2w-release --parallel 2\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Sync Workspace",
			"group": "build"
		},
		{
			"label": "Remote Pi: Run Release",
			"type": "shell",
			"command": "stdbuf -oL -eL ssh -t -o ServerAliveInterval=30 -o ServerAliveCountMax=120 atom@cockscreen \"cd /home/atom/cockscreen && ./out/build/pi-zero2w-release/cockscreen --enable-web-server http://0.0.0.0:8080\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Build Release",
			"group": "test",
			"isBackground": true
		},
		{
			"label": "Remote Pi: Smoke Release",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/run-pi-qt-shader-smoke.sh ./out/build/pi-zero2w-release/cockscreen scenes/pizero-linux.scene.jsonc 4 18",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Remote Pi: Build Release",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true,
				"focus": true
			}
		},
		{
			"label": "Local: Cross Build Windows Debug",
			"type": "shell",
			"command": "cmake --preset windows-x86_64-debug && cmake --build --preset windows-x86_64-debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Local: Cross Build Windows Release",
			"type": "shell",
			"command": "cmake --preset windows-x86_64-release && cmake --build --preset windows-x86_64-release",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		}
	]
}

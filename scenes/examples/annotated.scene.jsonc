{
    /*
     * Fully annotated scene template.
     * This file is meant to be copied into a new preset, not used as a shipped default.
     * Paths are resolved relative to this file unless already absolute.
     */
    "resources_directory": "../../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    "shader_directory": "../../shaders/",
    /* Valid runtime values: qt, qt-shader, v4l2-dmabuf-egl. */
    "render_path": "qt-shader",
    /*
     * Optional DRM/KMS device path override.  Defaults to the first available
     * DRM device when omitted.  Typically /dev/fb0 on Pi eglfs builds.
     */
    "render_device": "/dev/fb0",
    /* geometry.width and geometry.height are clamped to a minimum of 1. */
    "geometry": {
        "width": 1024,
        "height": 600
    },
    /*
     * Optional qt-shader offscreen target. The app/window can stay at the
     * physical display mode while shaders run at a lower resolution.
     * presentation: stretch, fit, fill, center, integer-scale.
     *   "crop" is accepted as an alias for "fill".
     *   "integer_scale" and "integer" are accepted as aliases for "integer-scale".
     * filter: linear or nearest.
     *   "pixelated" is accepted as an alias for "nearest".
     */
    "render_target": {
        "enabled": false,
        "width": 640,
        "height": 480,
        "presentation": "fit",
        "filter": "linear"
    },
    /*
     * Optional Pi-only secondary display.
     *
     * This supports small SPI framebuffer panels such as:
     * https://www.waveshare.com/1.3inch-lcd-hat.htm
     * and direct I2C/SPI SSD1309 OLEDs such as SparkFun's transparent OLED:
     * https://learn.sparkfun.com/tutorials/transparent-graphical-oled-breakout-hookup-guide/all
     *
     * For framebuffer panels the runtime writes compact pages to /dev/fb1. For
     * SSD1309 I2C panels set interface to "i2c" and device to a Linux I2C bus
     * such as /dev/i2c-1. For SSD1309 SPI panels set interface to "spidev" and
     * device to a Linux spidev node such as /dev/spidev0.0. It is not an
     * independent OpenGL render path, so it supports video/status pages rather
     * than custom GLSL shaders.
     *
     * Pages currently understood by default_page and control mappings:
     * - mode
     * - video_input
     * - system_performance_overview
     * - app_status_modulation
     * - linux_os_stats
     *
     * render_target has the same shape as the main render_target above.
     * For SparkFun's transparent SSD1309 OLED use 128x64. The runtime switches
     * the existing pages to compact monochrome layouts for this size. SparkFun
     * notes that 128x56 pixels are transparent inside the 128x64 controller
     * frame, so keep important text away from the very bottom if your mounting
     * hides that non-transparent strip.
     */
    "secondary_display": {
        "enabled": true,
        "device": "/dev/i2c-1",
        "model": "sparkfun-transparent-ssd1309",
        "interface": "i2c",
        "width": 128,
        "height": 64,
        /*
         * SSD1309 I2C options. SparkFun's default SA0-low address is 0x3c
         * (decimal 60); the parser accepts either 60 or the string "0x3c".
         * gpio_reset is optional; set it when reset is wired to a BCM GPIO.
         * The SparkFun board is 3.3V only; do not drive it with 5V logic.
         *
         * For 4-wire SPI instead, use:
         *   "device": "/dev/spidev0.0",
         *   "interface": "spidev",
         *   "spi_speed_hz": 8000000,
         *   "gpio_dc": 25
         */
        "i2c_address": "0x3c",
        "gpio_reset": -1,
        /*
         * Clockwise degrees applied before writing the framebuffer.
         * Accepted numerically by runtime; common values are 0, 90, 180, 270.
         * "rotation" is accepted as an alias for "rotation_degrees".
         */
        "rotation_degrees": 0,
        /* The parser also accepts "background" as an alias. */
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        "render_target": {
            "enabled": true,
            "width": 128,
            "height": 64,
            "presentation": "fit",
            "filter": "nearest"
        },
        /*
         * Initial page shown on startup. The video page mirrors the latest
         * captured frame into the small framebuffer.
         * Also accepted as "source" or "mode" (aliases for "default_page").
         * Page name aliases:
         *   video_input (default)
         *   mode
         *   system_performance_overview  →  also: "system", "system-performance"
         *   app_status_modulation        →  also: "app-status", "modulation"
         *   linux_os_stats               →  also: "linux", "linux-os", "os-stats", "system-stats"
         */
        "default_page": "video_input",
        /*
         * Video page options use the regular layer subset: enabled, opacity,
         * background_color/background, background_image. shaders[] is ignored
         * for the secondary display.
         */
        "video": {
            "enabled": true,
            "opacity": 1.0
        },
        /*
         * GPIO controls are polled from /sys/class/gpio when the framebuffer
         * is active. Each mapping has:
         * - gpio: BCM GPIO number.
         * - active_low: true for buttons wired low when pressed.
         * - action: set_page, cycle_page, next_page, previous_page.
         * - page: target page for set_page, or label shown on the mode page.
         *
         * SparkFun's transparent OLED does not provide built-in buttons, so
         * the example leaves controls empty. If you wire external controls,
         * use the same mapping shape below.
         *
         * Waveshare 1.3inch LCD HAT defaults, if you switch back to the
         * framebuffer model:
         * KEY1 21, KEY2 20, KEY3 16, UP 6, DOWN 19, LEFT 5, RIGHT 26,
         * joystick press 13.
         *
         * The three vertical buttons default to mode/cycle, video input, and
         * system performance. Joystick press opens app modulation status.
         * Any mapping can target linux_os_stats directly, or it can be reached
         * through cycle_page/next_page.
         */
        "controls": {}
    },
    /*
     * Top-level background_color is a fallback when inputs.background_color is omitted.
     * The parser also accepts the alias name "background".
     */
    "background_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 1.0
    },
    /*
     * Object form is preferred, but the parser also accepts:
     * "background_image": "textures/example.jpg"
     * plus legacy background_image_file / background_image_placement keys.
     */
    "background_image": {
        "file": "textures/masazer.jpg",
        /*
         * Accepted values: center, stretched, proportional-stretch, tiled.
         * Also accepted: centered, propotional-stretch, proportional_stretch.
         */
        "placement": "proportional-stretch"
    },
    "inputs": {
        "video": {
            "enabled": true,
            /*
             * device can be a local V4L2 node (/dev/videoN) or a network camera URL.
             *
             * Network sources (Linux only, via GStreamer appsink):
             *   "rtsp://user:pass@192.168.1.10/stream"  — H.264 RTSP (most IP cameras)
             *   "http://192.168.1.10/video.mjpg"        — HTTP MJPEG (multipart stream)
             *   "https://..."                           — same, with TLS
             *
             * For RTSP the pipeline is:
             *   rtspsrc → rtph264depay → h264parse → avdec_h264 → videoconvert → BGRx → appsink
             * For HTTP MJPEG:
             *   souphttpsrc → multipartdemux → jpegdec → videoconvert → BGRx → appsink
             *
             * Requires gst-plugins-good (rtspsrc, souphttpsrc) and gst-libav (avdec_h264, jpegdec).
             * QCamera is bypassed entirely; transport controls (start_ms, loop_*) are ignored.
             */
            "device": "/dev/video1",
            /*
             * Named capture resolution shortcuts: qvga (320x240), vga (640x480),
             * svga (800x600), xga (1024x768), 720p (1280x720), 1080p (1920x1080).
             * Also accepts an explicit "WxH" string, e.g. "1280x720".
             * Falls back to the window geometry dimensions when omitted.
             */
            "format": "qvga",
            /* scale is clamped to a minimum of 0.01. */
            "scale": 0.35,
            /* Preferred position form. */
            "position": {
                "x": 0.5,
                "y": 0.5
            },
            /* Rotation is in degrees and pivots around the video quad centre in qt-shader. */
            "rotation": 0.0,
            /*
             * Time-based transform animation for qt-shader.
             * Presets: rotate, resize, move-x, move-y, orbit, wobble, bounce.
             * speed is cycles per second; phase is a starting offset in cycles.
             * amount is preset-specific normalized intensity.
             */
            "animation": {
                "enabled": true,
                "preset": "move-x",
                "speed": 0.25,
                "amount": 0.15,
                "phase": 0.0
            },
            /*
             * Legacy fallback also exists:
             * "position_x": 0.5,
             * "position_y": 0.5
             */
            "position_x": 0.5,
            "position_y": 0.5,
            /*
             * CPU-side pixel buffer corruption applied per-frame before GPU upload.
             * All effects are reproducible given the same seed + frame index.
             * strength is clamped to [0, 1]; block_size minimum is 2.
             */
            "artifact": {
                "enabled": false,
                "scanline_drop": false,
                "block_corrupt": false,
                "bit_flip": false,
                "smear": false,
                "strength": 0.3,
                "block_size": 16,
                "seed": 42
            },
            /*
             * GStreamer RTP-over-UDP loopback with optional tc-netem network
             * impairments. Requires v4l2loopback kernel module and CAP_NET_ADMIN
             * (or root) for tc commands.
             *
             * When use_appsink is true the app reads decoded frames directly from
             * GStreamer via appsink rather than v4l2loopback, skipping the virtual
             * device entirely.
             *
             * loss_percent, corrupt_percent, and reorder_percent are clamped to
             * [0, 100]; delay_ms to >= 0; udp_port to [1024, 65535].
             */
            "loopback": {
                "enabled": false,
                "loss_percent": 0.0,
                "corrupt_percent": 0.0,
                "delay_ms": 0,
                "reorder_percent": 0.0,
                "udp_port": 5004,
                "loopback_device": "/dev/video10",
                "use_appsink": false
            }
        },
        "playback": {
            "enabled": true,
            /*
             * file can be a local path (relative to resources_directory or absolute)
             * or a network URL routed through Qt's GStreamer backend:
             *   "rtsp://192.168.1.10/stream"    — RTSP (H.264 or whatever codec the camera advertises)
             *   "http://192.168.1.10/video.mjpg" — HTTP MJPEG
             *   "https://..."
             * Transport controls (start_ms, loop_*, playback_rate) are ignored for
             * network URLs; the stream plays live and cannot be seeked.
             */
            "file": "../../resources/videos/example.mp4",
            "scale": 0.4,
            "position": {
                "x": 0.05,
                "y": 0.05
            },
            "rotation": -5.0,
            /* All transport numbers are clamped to >= 0. */
            "start_ms": 0,
            "loop_start_ms": 0,
            /* null or omission disables a custom loop end. */
            "loop_end_ms": 8000,
            /* 0 means infinite looping. */
            "loop_repeat": 0,
            /* playback_rate and playback_rate_looping are clamped to >= 0.01. */
            "playback_rate": 1.0,
            "playback_rate_looping": 0.75,
            /*
             * Playback audio volume envelope. All values clamped to [0, 1] except
             * the _ms fields which are clamped to >= 0.
             * volume        — steady-state peak level (default 1.0).
             * volume_initial — level at t=0, before the intro fade-in (default 0.0).
             * volume_fade_in_ms        — ms to ramp volume_initial → volume on first play.
             * volume_loop_fade_in_ms   — ms to ramp up to volume at the start of each loop.
             * volume_loop_fade_out_ms  — ms to ramp down before each loop end.
             * volume_fade_out_ms       — ms to ramp to 0 after the final loop or end-of-media.
             */
            "volume": 1.0,
            "volume_initial": 0.0,
            "volume_fade_in_ms": 0,
            "volume_loop_fade_in_ms": 0,
            "volume_loop_fade_out_ms": 0,
            "volume_fade_out_ms": 0,
            /*
             * When true, the audio embedded in the playback file is routed into
             * the FFT/level shader uniforms instead of the audio capture device.
             * Requires inputs.audio_playback to be configured.
             */
            "fft_analysis_from_playback": false,
            /* artifact and loopback work the same as for inputs.video. */
            "artifact": {
                "enabled": false,
                "scanline_drop": false,
                "block_corrupt": false,
                "bit_flip": false,
                "smear": false,
                "strength": 0.3,
                "block_size": 16,
                "seed": 42
            },
            "loopback": {
                "enabled": false,
                "loss_percent": 0.0,
                "corrupt_percent": 0.0,
                "delay_ms": 0,
                "reorder_percent": 0.0,
                "udp_port": 5004,
                "loopback_device": "/dev/video10",
                "use_appsink": false
            }
        },
        /* The parser also accepts inputs.background as an alias. */
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        /*
         * Audio capture device for FFT/level shader uniforms.
         * device tokens (case-insensitive):
         *   "@default_input@"         — first non-HDMI capture device (Linux default).
         *   "@default_monitor_output@" — PulseAudio/PipeWire monitor of the default sink;
         *     also accepted: @DEFAULT_OUTPUT_MONITOR@, @DEFAULT_MONITOR@,
         *     @default_monitor_output@, @DEFAULT_MONITOR_OUTPUT@.
         *   "@disabled@"              — disables audio capture entirely.
         *   Any other string is matched against device ID or description (case-insensitive).
         *
         * fft_analysis_enabled: when false the device is still opened for monitoring
         * but its signal does NOT drive FFT/level uniforms (useful if you are routing
         * analysis through inputs.audio_playback instead).
         */
        "audio": {
            "enabled": true,
            "device": "@default_monitor_output@",
            "fft_analysis_enabled": true
        },
        /*
         * Optional secondary audio capture input used exclusively for driving FFT
         * and level shader uniforms for the playback layer.  Configured identically
         * to inputs.audio.  Only active when inputs.playback.fft_analysis_from_playback
         * is true.  Set device to "@disabled@" (or omit entirely) to leave unused.
         */
        "audio_playback": {
            "enabled": false,
            "device": "@disabled@",
            "fft_analysis_enabled": true
        },
        "midi": {
            "enabled": true,
            "device": "through"
        }
    },
    /* Diagnostic overlay in the window. */
    "show_status_overlay": true,
    /* Analog-film-style timecode overlay on playback. */
    "timecode": true,
    /*
     * Scene-level defaults for pink_key.glsl.
     * audio_algorithm values:
     * 0 bass, 1 low-mid, 2 high-mid, 3 high, 4 spectral centroid, 5 full-spectrum average.
     */
    "pink_key": {
        "audio_algorithm": 0,
        /* audio_reactivity and midi_reactivity are clamped to [0, 1.5]. */
        "audio_reactivity": 0.45,
        "midi_reactivity": 0.35
    },
    /*
     * Layers accept enabled, opacity, shaders[], background_color/background,
     * background_image, and transform animation.
     *
     * playback can use inputs.playback scale/position/rotation/animation, or
     * this top-level playback transform. A top-level playback transform only
     * overrides the fields it declares, so an animation here can reuse the
     * input playback scale and position.
     *
     * screen has no input object, so its layer transform starts from full-screen
     * scale 1.0, position 0/0, rotation 0.
     */
    "video": {
        "enabled": true,
        "shaders": [
            "pink_key.glsl",
            "video_sphere.glsl"
        ]
    },
    "playback": {
        "enabled": false,
        "transform": {
            "animation": {
                "enabled": true,
                "preset": "wobble",
                "speed": 0.2,
                "amount": 0.15,
                "phase": 0.0
            }
        },
        "shaders": [
            "pixelize_loop.glsl"
        ]
    },
    "screen": {
        "enabled": true,
        /*
         * transform accepts scale/position/rotation/animation OR a rect block.
         * rect is an absolute normalized viewport rectangle [0,1] and overrides
         * scale and position entirely when present.  It can also be written
         * directly on the layer object (outside "transform").
         *
         * scale+position form (relative):
         */
        "transform": {
            "scale": 0.9,
            "position": {
                "x": 0.5,
                "y": 0.5
            },
            "rotation": 0.0,
            "animation": {
                "enabled": true,
                "preset": "rotate",
                "speed": 0.02,
                "amount": 1.0,
                "phase": 0.0,
                /*
                 * axis is an optional hint string passed to the animation
                 * implementation (e.g. "x", "y", "z").  Accepted by the
                 * parser; effect depends on the animation preset.
                 */
                "axis": ""
            }
        },
        /*
         * rect form (absolute, alternative to scale+position — uncomment to use):
         * "rect": {
         *     "x": 0.0,   // left edge, normalized 0–1 (clamped)
         *     "y": 0.0,   // top edge, normalized 0–1 (clamped)
         *     "w": 1.0,   // width, normalized 0–1 (clamped)
         *     "h": 1.0    // height, normalized 0–1 (clamped)
         * },
         */
        "shaders": [
            "wireframe_sphere.glsl",
            "crt_noise.glsl"
        ]
    },
    /*
     * Named layers (new-style, optional).
     *
     * The "layers" dict lets you define any number of named layers beyond the
     * three built-in keys (video / playback / screen).  Each entry is a layer
     * object plus two extra fields:
     *
     *   "type"  — "video", "playback", or "screen" (default "screen").
     *             Determines which input pipeline feeds the layer.
     *   "input" — inline SceneInput object (same fields as inputs.video /
     *             inputs.playback).  Required for type "video" and "playback".
     *
     * Built-in video / playback / screen keys are still parsed for backward
     * compatibility; named_layers always wins in rendering.
     * Refer to the layer by its dict key in midi_cc_mappings, osc_mappings,
     * shader_uniforms, and layer_order.
     */
    "layers": {
        /* A second live-camera feed on a different device. */
        "camera2": {
            "type": "video",
            "enabled": true,
            "opacity": 1.0,
            "shaders": ["pink_key.glsl"],
            /* rect pins this layer to the bottom-right quarter of the screen. */
            "rect": {
                "x": 0.5,
                "y": 0.5,
                "w": 0.5,
                "h": 0.5
            },
            "input": {
                "enabled": true,
                "device": "/dev/video2",
                "format": "qvga",
                "scale": 1.0,
                "position": { "x": 0.0, "y": 0.0 }
            }
        },
        /* A second playback clip running independently. */
        "clip2": {
            "type": "playback",
            "enabled": false,
            "opacity": 0.8,
            "shaders": [],
            "transform": {
                "scale": 0.3,
                "position": { "x": 0.1, "y": 0.9 }
            },
            "input": {
                "enabled": true,
                "file": "../../resources/videos/overlay.mp4",
                "scale": 1.0,
                "loop_repeat": 0,
                "playback_rate": 1.0
            }
        }
    },
    /*
     * layer_order controls the back-to-front compositing order.
     * List any combination of named layer keys — built-in (video, playback,
     * screen) and user-defined (e.g. camera2, clip2).
     * Duplicate and unknown entries are silently ignored.
     * Omitting this field uses runtime-default ordering.
     */
    "layer_order": [
        "screen",
        "clip2",
        "camera2",
        "playback",
        "video"
    ],
    /* MIDI CC mappings. */
    "midi_cc_mappings": [
        {
            "layer": "screen",
            /* shader can be a filename or a partial match. */
            "shader": "wireframe_sphere.glsl",
            "uniform": "u_wire_density",
            /* channel: 0–15 for a specific MIDI channel; -1 (or omit) matches all channels. */
            "channel": 0,
            "cc": 91,
            "min": 0.0,
            "max": 1.0,
            /* exponent is clamped to >= 0.01. */
            "exponent": 1.0
        }
    ],
    /*
     * MIDI note mappings use channel + note + min/max/exponent.
     * Note: decay is not currently parsed from scene files.
     */
    "midi_note_mappings": [
        {
            "layer": "screen",
            "shader": "crt_noise.glsl",
            "uniform": "u_note_flash",
            "channel": 0,
            "note": 60,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ],
    /*
     * OSC mappings identify the source by OSC address.
     * Fields are the same as MIDI mappings minus channel/cc/note.
     *
     * Analog CV input (Pi aarch64 only — Waveshare ADS1256 high-precision board):
     *   The runtime publishes each AD channel as a normalized [0, 1] OSC value at
     *   /analog/ad0 … /analog/ad7 on every ADC scan cycle.
     *
     *   Reference voltage is set with --ads-vref VOLTS (CLI) or the env var
     *   COCKSCREEN_ADS1256_VREF_VOLTS (default 3.3 V).
     *
     *   Additional env vars:
     *     COCKSCREEN_ADS1256_CHANNEL      — single channel to read when mux is off (0–7, default 0)
     *     COCKSCREEN_ADS1256_MUX_CHANNELS — enable CD74HC4067 mux; set >1 for multi-channel scan
     *                                       (1–16, default 1 = mux disabled)
     *     COCKSCREEN_ADS1256_PERIOD_MS    — sampling interval in ms; 0 = continuous polling
     *                                       (default 0, i.e. back-to-back DRDY-paced scans)
     *     COCKSCREEN_ADS1256_GATE_POLL_MS — digital gate input poll interval (0–10000, default 20 ms)
     *     COCKSCREEN_ADS1256_VREF_VOLTS   — same as --ads-vref (double)
     *
     *   GPIO wiring (BCM numbering):
     *     CS=22  RESET=18  PWDN=27  DRDY=17
     *     CD74HC4067 mux select: S0=BCM5  S1=BCM6  S2=BCM13  S3=BCM26
     *     Digital gate inputs:   G0=BCM16  G1=BCM19  G2=BCM20
     *
     *   Use osc_mappings with the /analog/adN addresses to route pots or CV signals
     *   to any shader uniform — no extra glue code required.
     */
    "osc_mappings": [
        {
            "address": "/cockscreen/key/hue",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_h",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        /*
         * Analog AD channel examples (Pi aarch64 / ADS1256 board).
         * AD0 pot → wireframe line density.
         * exponent > 1 gives a logarithmic feel (fine control at low end).
         */
        {
            "address": "/analog/ad0",
            "layer": "screen",
            "shader": "wireframe_plane.glsl",
            "uniform": "u_plane_base_speed",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.5
        },
        /* AD1 pot → pink key hue range width. */
        {
            "address": "/analog/ad1",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_hrange",
            "min": 0.0,
            "max": 0.5,
            "exponent": 1.0
        },
        /* AD7 pot → custom shader parameter (common last-channel wiring). */
        {
            "address": "/analog/ad7",
            "layer": "screen",
            "shader": "wireframe_sphere.glsl",
            "uniform": "u_wire_density",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ],
    /*
     * Static shader uniform overrides. Applied once at startup and not updated
     * by MIDI/OSC at runtime. Useful for setting scene-specific default values
     * for a shader parameter without touching the shader file itself.
     * layer and uniform are required; shader is an optional partial filename
     * match, same as in midi_cc_mappings.
     */
    "shader_uniforms": [
        {
            "layer": "screen",
            "shader": "wireframe_sphere.glsl",
            "uniform": "u_wire_density",
            "value": 0.5
        }
    ]
}

{
    /* Raspberry Pi 3B+ preset for fullscreen device use. */
    "resources_directory": "../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    /* Background image object form supports file + placement. */
    //"background_image": {
    //   "file": "textures/masazer.jpg",
    /* Parser accepts centered as an alias for center. */
    // "placement": "centered"
    //},
    "shader_directory": "/home/atom/cockscreen/shaders/",
    "render_path": "qt-shader",
    "render_device": "/dev/fb0",
    "geometry": {
        "width": 256,
        "height": 256
    },
    "render_target": {
        "enabled": true,
        "width": 278,
        "height": 309,
        "presentation": "stretch",
        "filter": "nearest"
    },
    "secondary_display": {
        "enabled": true,
        "device": "/dev/i2c-1",
        "model": "sparkfun-transparent-ssd1309",
        "interface": "i2c",
        "width": 128,
        "height": 64,
        "rotation_degrees": 0,
        "i2c_address": "0x3c",
        "gpio_reset": -1,
        "render_target": {
            "enabled": true,
            "width": 128,
            "height": 64,
            "presentation": "fit",
            "filter": "nearest"
        },
        "default_page": "video_input",
        "video": {
            "enabled": true,
            "opacity": 1.0
        },
        "controls": {}
    },
    /*
     * Named layers (new-style, optional).
     *
     * The "layers" dict lets you define any number of named layers beyond the
     * three built-in keys (video / playback / screen).  Each entry is a layer
     * object plus two extra fields:
     *
     *   "type"  — "video", "playback", or "screen" (default "screen").
     *             Determines which input pipeline feeds the layer.
     *   "input" — inline SceneInput object (same fields as inputs.video /
     *             inputs.playback).  Required for type "video" and "playback".
     *
     * Built-in video / playback / screen keys are still parsed for backward
     * compatibility; named_layers always wins in rendering.
     * Refer to the layer by its dict key in midi_cc_mappings, osc_mappings,
     * shader_uniforms, and layer_order.
     */
    "layers": {
        "camera2": {
            "type": "video",
            "enabled": true,
            "opacity": 1.0,
            "shaders": [],
            "input": {
                "enabled": true,
                "device": "/dev/video2",
                "scale": 1.0,
                "format": "vga"
            }
        }
    },
    "show_status_overlay": false,
    "screen": {
        "enabled": true,
        "opacity": 1.0,
        "shaders": [
            //"psychotherapy.glsl",
            //"pink_key.glsl"
            //"fluid_flow.glsl"
            "wireframe_plane.glsl"
        ],
        "animation": {
            "enabled": true,
            "preset": "rotate",
            "speed": 0.02,
            "amount": 1.0,
            "phase": 0.0,
            /*
                 * axis is an optional hint string passed to the animation
                 * implementation (e.g. "x", "y", "z").  Accepted by the
                 * parser; effect depends on the animation preset.
                 */
            "axis": "x"
        }
    },
    /* Compositing order from back to front. */
    "layer_order": [
        "camera2"
    ]
}
{
    /* Raspberry Pi 3B+ preset for fullscreen device use. */
    "resources_directory": "../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    /* Background image object form supports file + placement. */
    //"background_image": {
    //   "file": "textures/masazer.jpg",
    /* Parser accepts centered as an alias for center. */
    // "placement": "centered"
    //},
    "shader_directory": "/home/atom/cockscreen/shaders/",
    "render_path": "qt-shader",
    "render_device": "/dev/fb0",
    "geometry": {
        "width": 256,
        "height": 128
    },
    /*
     * Keep HDMI at the panel-native 1024x600, but render shaders into a
     * cheaper offscreen target and scale that texture to the screen. This
     * stays useful on the Pi 3B+ because fragment shader cost dominates.
     */
    "render_target": {
        "enabled": true,
        "width": 320,
        "height": 240,
        "presentation": "stretch",
        "filter": "nearest"
    },
    /*
     * Waveshare 1.3inch LCD HAT secondary display:
     * 240x240 SPI framebuffer, rotated clockwise for the mounted panel.
     * The framebuffer path is selected at runtime on Pi targets only.
     */
    "secondary_display": {
        "enabled": true,
        "device": "/dev/fb1",
        "model": "waveshare-1.3inch-lcd-hat",
        "width": 240,
        "height": 240,
        "rotation_degrees": 90,
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        "render_target": {
            "enabled": true,
            "width": 240,
            "height": 240,
            "presentation": "fit",
            "filter": "nearest"
        },
        "default_page": "video_input",
        "video": {
            "enabled": true,
            "opacity": 1.0
        },
        "controls": {
            "key1": {
                "gpio": 21,
                "active_low": true,
                "action": "cycle_page",
                "page": "mode"
            },
            "key2": {
                "gpio": 20,
                "active_low": true,
                "action": "set_page",
                "page": "video_input"
            },
            "key3": {
                "gpio": 16,
                "active_low": true,
                "action": "set_page",
                "page": "system_performance_overview"
            },
            "joystick_press": {
                "gpio": 13,
                "active_low": true,
                "action": "set_page",
                "page": "app_status_modulation"
            },
            "joystick_up": {
                "gpio": 6,
                "active_low": true,
                "action": "previous_page",
                "page": "mode"
            },
            "joystick_down": {
                "gpio": 19,
                "active_low": true,
                "action": "next_page",
                "page": "mode"
            },
            "joystick_left": {
                "gpio": 5,
                "active_low": true,
                "action": "previous_page",
                "page": "mode"
            },
            "joystick_right": {
                "gpio": 26,
                "active_low": true,
                "action": "next_page",
                "page": "mode"
            }
        }
    },
    "inputs": {
        "video": {
            "enabled": false,
            "device": "/dev/video2",
            "format": "1024x600",
            /*
             * Time-based transform animation for the video quad.
             * Presets: rotate, resize, move-x, move-y, orbit, wobble, bounce.
             * speed is cycles per second; phase is a starting offset in cycles.
             * amount is preset-specific normalized intensity.
             */
            "animation": {
                "enabled": false,
                "preset": "resize",
                "speed": 0.04,
                "amount": 0.6,
                "phase": 2.0
            },
            "scale": 1.0,
            /* Preferred position form. */
            "position": {
                "x": 0.5,
                "y": 0.5
            }
        },
        "playback": {
            "enabled": false,
            "file": "/home/atom/Videos/nana5minute.mpeg",
            "scale": 0.15,
            "position": {
                "x": 0.5,
                "y": 0.5
            },
            /* Null or omitted loop_end_ms disables a custom loop end. */
            "start_ms": 0,
            "loop_start_ms": 0,
            "loop_end_ms": null,
            "loop_repeat": 0,
            "playback_rate": 1.0,
            "playback_rate_looping": 1.0,
            "animation": {
                "enabled": true,
                "preset": "rotate",
                "speed": 0.04,
                "amount": 0.6,
                "phase": 2.0
            }
        },
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        "audio": {
            "enabled": false,
            "device": "MS210x Video Grabber [EasierCAP] Analog Stereo"
        },
        "midi": {
            "enabled": false,
            "device": "SQ-1"
        }
    },
    "show_status_overlay": true,
    "video": {
        "enabled": false,
        "opacity": 1.0,
        "shaders": []
    },
    "playback": {
        "enabled": false,
        "opacity": 1.0,
        "shaders": []
    },
    "screen": {
        "enabled": true,
        "opacity": 1.0,
        "shaders": [
            "fluid_flow.glsl"
        ]
    },
    /* Compositing order from back to front. */
    "layer_order": [
        "screen"
    ],
    /*
     * fluid_flow.glsl startup defaults – aurora preset.
     * Match presets/fluid_flow.glsl/aurora.json so the web UI preset loads are idempotent.
     */
    "shader_uniforms": [
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_flow_speed",
            "value": 0.3
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_flow_scale",
            "value": 2.0
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_turbulence",
            "value": 0.5
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_whirl_x",
            "value": 0.5
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_whirl_y",
            "value": 0.5
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_whirl_strength",
            "value": 2.5
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_whirl_radius",
            "value": 0.25
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_palette_shift",
            "value": 0.55
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_palette_contrast",
            "value": 0.7
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_color_speed",
            "value": 0.08
        },
        {
            "layer": "screen",
            "shader": "fluid_flow.glsl",
            "uniform": "u_brightness",
            "value": 1.0
        }
    ]
}
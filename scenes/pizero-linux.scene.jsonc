{
    /* Raspberry Pi Zero 2 W preset for fullscreen device use. */
    "resources_directory": "../resources/",
    "shader_directory": "../shaders/",
    "render_path": "qt-shader",
    "geometry": {
        "width": 1024,
        "height": 600
    },
    "inputs": {
        "video": {
            "enabled": true,
            "device": "/dev/video0",
            "format": "qvga",
            "scale": 0.3,
            "on_top": false,
            "position": {
                "x": 0.5,
                "y": 0.6
            }
        },
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        }
    },
    "show_status_overlay": false,
    /* Enabled layer + ordered shader chain per compositing stage. */
    "video": {
        "enabled": true,
        "shaders": [
            //"edge_distortion.glsl",
            "rat_distortion.glsl"
        ]
    },
    "playback": {
        "enabled": false,
        "shaders": []
    },
    "screen": {
        "enabled": true,
        "shaders": [
            ""
        ]
    },
    /* Compositing order from back to front. */
    "layer_order": [
        "screen",
        "video"
    ]
}
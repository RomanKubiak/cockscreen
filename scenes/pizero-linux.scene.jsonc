{
    /* Raspberry Pi 3B+ preset for fullscreen device use. */
    "resources_directory": "../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    /* Background image object form supports file + placement. */
    //"background_image": {
    //   "file": "textures/masazer.jpg",
    /* Parser accepts centered as an alias for center. */
    // "placement": "centered"
    //},
    "shader_directory": "../shaders/",
    "render_path": "qt-shader",
    "geometry": {
        "width": 640,
        "height": 480
    },
    /*
     * Keep HDMI at the panel-native 1024x600, but render shaders into a
     * cheaper offscreen target and scale that texture to the screen. This
     * stays useful on the Pi 3B+ because fragment shader cost dominates.
     */
    "render_target": {
        "enabled": true,
        "width": 447,
        "height": 163,
        "presentation": "stretch",
        "filter": "nearest"
    },
    "inputs": {
        "video": {
            "enabled": true,
            "device": "/dev/video0",
            "format": "qvga",
            /*
             * Time-based transform animation for the video quad.
             * Presets: rotate, resize, move-x, move-y, orbit, wobble, bounce.
             * speed is cycles per second; phase is a starting offset in cycles.
             * amount is preset-specific normalized intensity.
             */
            "animation": {
                "enabled": true,
                "preset": "resize",
                "speed": 0.04,
                "amount": 0.6,
                "phase": 2.0
            },
            "scale": 1.0,
            /* Preferred position form. */
            "position": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "playback": {
            "enabled": false,
            "file": "/home/atom/Videos/video.mp4",
            "scale": 0.28,
            "position": {
                "x": 0.02,
                "y": 0.02
            },
            /* Null or omitted loop_end_ms disables a custom loop end. */
            "start_ms": 0,
            "loop_start_ms": 0,
            "loop_end_ms": null,
            "loop_repeat": 0,
            "playback_rate": 1.0,
            "playback_rate_looping": 1.0
        },
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        "audio": {
            "enabled": true,
            "device": "MS210x Video Grabber [EasierCAP] Analog Stereo"
        },
        "midi": {
            "enabled": false,
            "device": "SQ-1"
        }
    },
    "show_status_overlay": false,
    "shader_uniforms": [
        /*
         * 2026-05-14 autonomous Pi pass:
         * wireframe_plane.glsl ignores audio input and now renders only the
         * autonomous plane. The shader applies a 4x travel multiplier on top
         * of this base speed.
         */
        {
            /* Base forward travel speed for the autonomous plane motion. */
            "layer": "screen",
            "shader": "wireframe_plane.glsl",
            "uniform": "u_plane_base_speed",
            "value": 0.008
        }
    ],
    "video": {
        "enabled": true,
        "opacity": 1.0,
        "shaders": [
            "shadertoy.com/Nice_glass_wall.glsl"
        ]
    },
    "playback": {
        "enabled": false,
        "opacity": 1.0,
        "shaders": []
    },
    "screen": {
        "enabled": false,
        "opacity": 0.5,
        "background_color": {
            "r": 0.5,
            "g": 0.5,
            "b": 0.5,
            "a": 0.5
        },
        "shaders": []
    },
    /* Compositing order from back to front. */
    "layer_order": [
        "video",
        "screen"
    ]
}

{
    /*
     * Desktop Linux preset used for local development.
     * Paths are resolved relative to this file unless already absolute.
     */
    "resources_directory": "../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    "shader_directory": "/home/atom/devel/cockscreen/shaders/",
    /* Render path choices are qt, qt-shader, and v4l2-dmabuf-egl. */
    "render_path": "qt-shader",
    /* Window size in pixels. */
    "geometry": {
        "width": 1024,
        "height": 600
    },
    "inputs": {
        /* Live camera / capture-device input. */
        "video": {
            "enabled": false,
            "device": "/dev/video0",
            "format": "vga",
            "scale": 0.25,
            /* Legacy fallback if layer_order is omitted. */
            "on_top": false,
            "position": {
                "x": 0.5,
                "y": 0.5
            }
        },
        /* File playback input. Position is normalized in viewport space. */
        "playback": {
            "enabled": false,
            "file": "/home/atom/Videos/pizza.mp4",
            "scale": 1.0,
            "on_top": true,
            "position": {
                "x": 0,
                "y": 0
            },
            /* Playback transport controls. */
            "start_ms": 14000,
            "loop_start_ms": 18000,
            "loop_end_ms": 20000,
            /* 0 means infinite looping. */
            "loop_repeat": 0,
            /* Normal playback speed outside and inside the loop range. */
            "playback_rate": 1.0,
            "playback_rate_looping": 0.5
        },
        /* Clear color used behind all layers. */
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        /* Audio input used for global uniforms like u_audio_rms and u_audio_fft[16]. */
        "audio": {
            "enabled": false,
            "device": "@default_input@",
            /* Set false to prevent the device capture from driving u_audio_fft etc.
               Useful when fft_analysis_from_playback is true and you want only
               the audio file to drive the FFT uniforms. */
            "fft_analysis_enabled": true
        },
        /* Audio file playback — same transport controls as video playback. */
        "audio_playback": {
            "enabled": false,
            "file": "/home/atom/Music/example.mp3",
            /* Start position in ms. */
            "start_ms": 0,
            /* Loop window: set loop_end_ms to enable; 0 = full file. */
            "loop_start_ms": 0,
            "loop_end_ms": 0,
            /* 0 = infinite loop. */
            "loop_repeat": 0,
            /* Playback speed outside and inside the loop window. */
            "playback_rate": 1.0,
            "playback_rate_looping": 1.0,
            /* Volume controls. All times in milliseconds. */
            /* Peak volume [0.0 – 1.0] applied once fully faded in. */
            "volume": 1.0,
            /* Volume level at t=0 before any intro fade. */
            "volume_initial": 0.0,
            /* ms to ramp from volume_initial → volume at the very start. */
            "volume_fade_in_ms": 0,
            /* ms at the start of each loop iteration to ramp up to volume. */
            "volume_loop_fade_in_ms": 0,
            /* ms before the end of each loop iteration to ramp down to 0. */
            "volume_loop_fade_out_ms": 0,
            /* ms to fade to 0 after the final loop ends or end-of-media. */
            "volume_fade_out_ms": 0,
            /* Route this audio file through the FFT/level pipeline so that
               u_audio_fft, u_audio_rms, u_audio_peak, u_audio_level reflect
               the playing file instead of the external capture device. */
            "fft_analysis_from_playback": false
        },
        /* MIDI input used for global note / CC state and mapping targets. */
        "midi": {
            "enabled": false,
            "device": "through"
        }
    },
    /* Status overlay in the top-left diagnostic HUD. */
    "show_status_overlay": false,
    /* Burned-in timecode overlay on the playback image. */
    "timecode": false,
    /*
     * Scene-level defaults consumed by pink_key.glsl.
     * audio_algorithm: 0 bass, 1 low-mid, 2 high-mid, 3 high, 4 centroid, 5 full average.
     */
    "pink_key": {
        "audio_algorithm": 3,
        "audio_reactivity": 0.4,
        "midi_reactivity": 0.6
    },
    /* Shader chains per compositing layer. */
    "video": {
        "enabled": false,
        "shaders": [
            "pink_key.glsl"
        ]
    },
    "playback": {
        "enabled": false,
        "shaders": [
            "pink_key.glsl"
        ]
    },
    "screen": {
        "enabled": true,
        "shaders": [
            "psychotherapy.glsl",
            "font_awesome_burst.glsl"
        ]
    },
    /* Back-to-front final compositing order. */
    "layer_order": [
        "screen",
        "video",
        "playback"
    ],
    /* MIDI CC mappings: layer + shader identify the target stage, uniform receives the mapped value. */
    "midi_cc_mappings": [
        {
            "layer": "screen",
            "shader": "wireframe_sphere.glsl",
            "uniform": "u_wire_density",
            "channel": 0,
            "cc": 91,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "screen",
            "shader": "pixelize_viewport.glsl",
            "uniform": "u_pixelize_amount",
            "channel": 0,
            "cc": 92,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_h",
            "channel": 0,
            "cc": 93,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_hrange",
            "channel": 0,
            "cc": 94,
            "min": 0.0,
            "max": 0.5,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_spread",
            "channel": 0,
            "cc": 95,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ],
    /* OSC mappings use the same min/max/exponent shaping as MIDI mappings. */
    "osc_mappings": [
        {
            "address": "/cockscreen/key/hue",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_h",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/hrange",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_hrange",
            "min": 0.0,
            "max": 0.5,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/spread",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_spread",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/smin",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_smin",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ]
}
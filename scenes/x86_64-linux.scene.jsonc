{
    /*
     * Desktop Linux preset used for local development.
     * Paths are resolved relative to this file unless already absolute.
     */
    "resources_directory": "../resources/",
    "note_font_file": "fonts/MaxelFreePersonalUseRegular-G3AAP.ttf",
    "shader_directory": "/home/atom/devel/cockscreen/shaders/",
    /* Render path choices are qt, qt-shader, and v4l2-dmabuf-egl. */
    "render_path": "qt-shader",
    /* Window size in pixels. */
    "geometry": {
        "width": 1024,
        "height": 600
    },
    "inputs": {
        /* Live camera / capture-device input. */
        "video": {
            "enabled": false,
            "device": "/dev/video0",
            "format": "vga",
            "scale": 0.25,
            /* Legacy fallback if layer_order is omitted. */
            "on_top": false,
            "position": {
                "x": 0.5,
                "y": 0.5
            }
        },
        /* File playback input. Position is normalized in viewport space. */
        "playback": {
            "enabled": true,
            "file": "/home/atom/Videos/pizza.mp4",
            "scale": 1.0,
            "on_top": true,
            "position": {
                "x": 0,
                "y": 0
            },
            /* Playback transport controls. */
            "start_ms": 14000,
            "loop_start_ms": 18000,
            "loop_end_ms": 20000,
            /* 0 means infinite looping. */
            "loop_repeat": 0,
            /* Normal playback speed outside and inside the loop range. */
            "playback_rate": 1.0,
            "playback_rate_looping": 0.5,
            /**
             * @object loopback
             * @description GStreamer + tc-netem video re-encode pipeline.
             *   The sender decodes the source file, re-encodes it (H.264 via x264enc
             *   when available, otherwise MJPEG), and streams it over a local UDP port.
             *   tc-netem is applied to the loopback (lo) interface to inject packet
             *   loss, corruption, delay, and reorder before the in-process GStreamer
             *   receiver decodes and delivers frames to the GL pipeline.
             *   With H.264 (use_appsink=true), corrupted P-frames produce persistent
             *   macroblock artifacts until the next IDR (~2 s at key-int-max=60).
             *   Requires CAP_NET_ADMIN — run as root or via sudo.
             *   v4l2loopback (use_appsink=false only):
             *     sudo modprobe v4l2loopback devices=1 video_nr=10 card_label="cockscreen-lb"
             */
            "loopback": {
                /** @field enabled {boolean} Activates the loopback pipeline. When false, playback is direct (no re-encode, no netem). */
                "enabled": true,
                /** @field loss_percent {number} [0, 100] Percentage of UDP packets dropped by tc-netem. Dropped packets produce brief freeze holds. */
                "loss_percent": 0.0,
                /**
                 * @field corrupt_percent {number} [0, 100] Percentage of UDP packets that receive random bit-flips via tc-netem.
                 *   With use_appsink=true (H.264): corrupts P-frame bitstream → avdec_h264 outputs garbled macroblocks that persist
                 *   until the next IDR. Effective range for visible artifacts without full decode failure: 20–60.
                 */
                "corrupt_percent": 0.0,
                /**
                 * @field delay_ms {integer} [0, ∞) Fixed added latency in milliseconds applied to the lo interface by tc-netem.
                 *   Must be > 0 for reorder_percent to have any visible effect.
                 */
                "delay_ms": 0,
                /**
                 * @field reorder_percent {number} [0, 100] Percentage of packets reordered (delivered out of sequence).
                 *   Requires delay_ms > 0. Stresses the RTP jitter buffer; can cause reference-frame mismatches in H.264.
                 */
                "reorder_percent": 25.0,
                /** @field udp_port {integer} Local UDP port for the loopback RTP stream. Sender writes, receiver binds. */
                "udp_port": 5004,
                /** @field loopback_device {string} v4l2loopback device path. Used only when use_appsink is false. */
                "loopback_device": "/dev/video10",
                /**
                 * @field use_appsink {boolean} Selects the receiver backend.
                 *   true  — in-process GStreamer appsink path: H.264 over RTP/UDP → avdec_h264 → QVideoSink.
                 *           Supports start_ms, loop_start_ms, loop_end_ms, corrupt_percent glitch artifacts.
                 *   false — v4l2loopback path: GStreamer writes to /dev/videoN, Qt reads it back.
                 */
                "use_appsink": true
            }
        },
        /* Clear color used behind all layers. */
        "background_color": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0
        },
        /* Audio input used for global uniforms like u_audio_rms and u_audio_fft[16]. */
        "audio": {
            "enabled": false,
            "device": "@default_input@"
        },
        /* MIDI input used for global note / CC state and mapping targets. */
        "midi": {
            "enabled": false,
            "device": "through"
        }
    },
    /* Status overlay in the top-left diagnostic HUD. */
    "show_status_overlay": false,
    /* Burned-in timecode overlay on the playback image. */
    "timecode": false,
    /*
     * Scene-level defaults consumed by pink_key.glsl.
     * audio_algorithm: 0 bass, 1 low-mid, 2 high-mid, 3 high, 4 centroid, 5 full average.
     */
    "pink_key": {
        "audio_algorithm": 3,
        "audio_reactivity": 0.4,
        "midi_reactivity": 0.6
    },
    /* Shader chains per compositing layer. */
    "video": {
        "enabled": false,
        "shaders": [
            "pink_key.glsl"
        ]
    },
    "playback": {
        "enabled": true,
        "shaders": []
    },
    "screen": {
        "enabled": true,
        "shaders": []
    },
    /* Back-to-front final compositing order. */
    "layer_order": [
        "screen",
        "playback"
    ],
    /* MIDI CC mappings: layer + shader identify the target stage, uniform receives the mapped value. */
    "midi_cc_mappings": [
        {
            "layer": "screen",
            "shader": "wireframe_sphere.glsl",
            "uniform": "u_wire_density",
            "channel": 0,
            "cc": 91,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "screen",
            "shader": "pixelize_viewport.glsl",
            "uniform": "u_pixelize_amount",
            "channel": 0,
            "cc": 92,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_h",
            "channel": 0,
            "cc": 93,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_hrange",
            "channel": 0,
            "cc": 94,
            "min": 0.0,
            "max": 0.5,
            "exponent": 1.0
        },
        {
            "layer": "playback",
            "shader": "pink_key.glsl",
            "uniform": "u_key_spread",
            "channel": 0,
            "cc": 95,
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ],
    /* OSC mappings use the same min/max/exponent shaping as MIDI mappings. */
    "osc_mappings": [
        {
            "address": "/cockscreen/key/hue",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_h",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/hrange",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_hrange",
            "min": 0.0,
            "max": 0.5,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/spread",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_spread",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        },
        {
            "address": "/cockscreen/key/smin",
            "layer": "video",
            "shader": "pink_key.glsl",
            "uniform": "u_key_smin",
            "min": 0.0,
            "max": 1.0,
            "exponent": 1.0
        }
    ]
}